+import config from './isu-feed-config.mjs';
+import {createFeedClient,startFeedRefresh} from './isu-feed-client.mjs';
+export function connectIsuFeed(data){
+ if(!config.enabled)return; // No production network calls before explicit activation.
+ const baseline=structuredClone(data);
+ const client=createFeedClient({...config,baseline,onUpdate:next=>{data.events=next.events;window.dispatchEvent(new CustomEvent('isu-feed-update',{detail:next}));},onStatus:(status,at)=>{
+  const list=document.querySelector('#race-event-list');if(!list)return;
+  let note=document.querySelector('[data-isu-feed-status]');if(!note){note=document.createElement('p');note.className='calendar-footnote';note.dataset.isuFeedStatus='';note.setAttribute('role','status');list.before(note);}
+  const en=document.documentElement.lang==='en';
+  note.textContent=status==='current'?(en?'ISU schedule updated: ':'ISU programma atjaunota: ')+new Intl.DateTimeFormat(en?'en-GB':'lv-LV',{timeZone:'Europe/Riga',dateStyle:'short',timeStyle:'short'}).format(new Date(at)):(en?'Showing the last verified schedule.':'Rādīta pēdējā pārbaudītā programma.');
+ }});
+ return startFeedRefresh(client);
+}
