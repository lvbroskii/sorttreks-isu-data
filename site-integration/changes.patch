+// New behavior tests read actual implementation files, without historical normalization.
+import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';
+import {mergeFeed,validateFeed} from '../dist/assets/isu-feed-contract.mjs';
+import {competitionProgrammeDays,competitionProgrammeMarkup} from '../dist/assets/calendar.mjs';
+import {panelView} from '../dist/assets/race-panel.mjs';
+import {noticeTarget} from '../dist/assets/programme-notice.mjs';
+const read=n=>JSON.parse(readFileSync(new URL('../dist/preview/fixtures/'+n+'.json',import.meta.url)));
+const baseline=read('website-baseline'),feed=read('draws'),now=Date.parse(feed.issuedAt),opts={now,allowSynthetic:true,baselineDigest:feed.baselineDigest};
+test('both languages show full opening programme without invented participation',()=>{for(const lang of ['lv','en']){const data=mergeFeed(baseline,read('schedule'),opts);const days=competitionProgrammeDays(data.events[1],lang);assert.equal(days.length,3);assert.equal(days[0].sessions.length,2);assert.ok(days.every(d=>d.sessions.every(s=>s.athletes.length===0)));assert.equal(days[0].sessions[0].viewingTime,lang==='lv'?'30.10. 15:20':'30 Oct, 15:20');assert.ok(competitionProgrammeMarkup(data.events[1],lang,now).includes('starti-2026-27-wt2'));}});
+test('draws attach to exact existing rounds once; revision changes time without changing first round',()=>{for(const lang of ['lv','en']){let data=mergeFeed(baseline,feed,opts);const starts=competitionProgrammeDays(data.events[1],lang)[0].sessions;assert.equal(starts.length,2);assert.deepEqual(starts.map(s=>s.athletes),[['Reinis Bērziņš'],['Roberts Krūzbergs']]);data=mergeFeed(data,read('revised'),opts);const next=competitionProgrammeDays(data.events[1],lang)[0].sessions;assert.equal(next[1].startsAt,'2026-10-30T13:35:00-04:00');assert.equal(next[1].athletes[0],'Roberts Krūzbergs');}});
+test('homepage countdown and participation navigation remain actual production implementations',()=>{const rounds=mergeFeed(baseline,feed,opts);const withoutEvent=({event,...view})=>view;assert.deepEqual(withoutEvent(panelView(mergeFeed(baseline,read('schedule'),opts).events,now)),withoutEvent(panelView(baseline.events,now)));assert.equal(noticeTarget(rounds.events,now),'/kalendars?filter=senior#starti-2026-27-wt2');const session=mergeFeed(rounds,read('session'),opts);const state=panelView(session.events,now);assert.equal(state.mode,'countdown');assert.equal(state.event.startsAt,'2026-10-30T09:00:00-04:00');assert.notDeepEqual(state.parts,panelView(baseline.events,now).parts);assert.notEqual(panelView(session.events,Date.parse(state.event.startsAt)).mode,'live');});
+test('verified website fallback is byte-equivalent and production integration disabled',async()=>{assert.deepEqual(read('website-baseline'),JSON.parse(readFileSync(new URL('../dist/assets/races.json',import.meta.url))));const {default:config}=await import('../dist/assets/isu-feed-config.mjs');assert.equal(config.enabled,false);assert.equal(config.url,'');assert.throws(()=>validateFeed(feed,{now}));});
