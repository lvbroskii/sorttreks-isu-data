+import {createFeedClient} from '../assets/isu-feed-client.mjs';
+import {calendarMarkup} from '../assets/calendar.mjs';
+import {panelView,renderPanel} from '../assets/race-panel.mjs';
+const baseline=await (await fetch('./fixtures/website-baseline.json')).json();
+const fixtures={};for(const name of ['schedule','draws','revised','session','conflict'])fixtures[name]=await(await fetch('./fixtures/'+name+'.json')).json();
+let lastStatus='fallback',lastAt;
+function statusText(status,at){lastStatus=status;lastAt=at;document.querySelector('#preview-status').textContent=(document.documentElement.lang==='en'?{current:'Verified test feed applied',retained:'Unavailable or rejected update - last accepted schedule retained',fallback:'Bundled website fallback'}:{current:'Pārbaudītā testa programma piemērota',retained:'Atjauninājums nav pieejams vai noraidīts - saglabāta pēdējā pārbaudītā programma',fallback:'Vietnes pārbaudītie rezerves dati'})[status]+(at?' · '+at:'');}
+let clock=Date.parse(fixtures.schedule.issuedAt),data=baseline,scenario='baseline';
+const baselineDigest=fixtures.schedule.baselineDigest;
+function draw(){
+ const lang=document.documentElement.lang;
+ const units=lang==='en'?{dienas:'days',stundas:'hours',minūtes:'minutes',sekundes:'seconds'}:{days:'dienas',hours:'stundas',minutes:'minūtes',seconds:'sekundes'};
+ const walker=document.createTreeWalker(document.querySelector('.next-race'),NodeFilter.SHOW_TEXT);while(walker.nextNode()){const n=walker.currentNode;const word=n.nodeValue.trim();if(units[word])n.nodeValue=n.nodeValue.replace(word,units[word]);}
+ statusText(lastStatus,lastAt);
+ document.querySelector('[data-preview-title]').textContent=lang==='en'?'ISU schedule updates':'ISU programmas atjauninājumi';
+ document.querySelector('#preview-calendar').innerHTML=calendarMarkup({...data,events:data.events.filter(e=>e.id==='2026-27-wt2'),domesticEvents:[]},lang,clock);
+ for(const details of document.querySelectorAll('#preview-calendar .calendar-sessions'))details.open=true;
+ renderPanel(document.querySelector('.next-race'),panelView(data.events,clock));
+}
+const client=createFeedClient({baseline,baselineDigest,url:'https://synthetic-preview.invalid/feed',enabled:true,allowSynthetic:true,storage:null,now:()=>clock,
+ fetcher:async()=>{if(scenario==='offline')throw Error('Synthetic network failure');return new Response(JSON.stringify(fixtures[scenario]));},onUpdate:x=>{data=x;draw()},onStatus:statusText});
+document.querySelectorAll('[data-scenario]').forEach(button=>button.addEventListener('click',async()=>{
+ scenario=button.dataset.scenario;for(const b of document.querySelectorAll('[data-scenario]'))b.setAttribute('aria-pressed',String(b===button));
+ if(scenario==='baseline'){data=structuredClone(baseline);draw();document.querySelector('#preview-status').textContent='Bundled baseline - no remote feed applied';return;}
+ if(scenario==='expired'){clock+=7*3600000;client.expire();return;}
+ // Start a fresh sequence after an expiry; revision buttons otherwise follow real monotonic rules.
+ clock=Date.parse(fixtures.schedule.issuedAt);await client.refresh();
+}));
+document.querySelectorAll('[data-preview-lang]').forEach(button=>button.addEventListener('click',()=>{document.documentElement.lang=button.dataset.previewLang;draw()}));
+draw();document.querySelector('#preview-status').textContent='Bundled baseline - no remote feed applied';
